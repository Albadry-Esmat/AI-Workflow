{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Safety Signal Detector output (P1 observe v0.1.0)",
  "type": "object",
  "required": ["signals", "floor_recommendation", "detector_version", "policy_version"],
  "properties": {
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signal", "matched", "evidence"],
        "properties": {
          "signal": {"type": "string"},
          "matched": {"type": "boolean"},
          "evidence": {"type": "string"}
        }
      }
    },
    "floor_recommendation": {"type": "string", "enum": ["FAST", "STANDARD", "GOVERNED"]},
    "detector_version": {"type": "string"},
    "policy_version": {"type": "string"}
  }
}
