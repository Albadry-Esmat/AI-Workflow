{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Intelligence Classification (P1 shadow v0.1.0)",
  "type": "object",
  "required": ["intent", "primary_goal", "complexity", "risk", "scope", "blast_radius", "required_capabilities", "requires_code_change", "requires_deployment", "confidences", "overall_confidence", "provenance"],
  "properties": {
    "intent": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "primary_goal": {"type": "string"},
    "complexity": {"type": "string", "enum": ["tiny", "small", "medium", "large", "xl"]},
    "risk": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "scope": {"type": "string"},
    "blast_radius": {"type": "string"},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "requires_code_change": {"type": "boolean"},
    "requires_deployment": {"type": "boolean"},
    "uncertainty": {"type": "object"},
    "confidences": {
      "type": "object",
      "required": ["intent", "primary_goal", "risk", "blast_radius", "scope", "capabilities", "architecture_impact"],
      "properties": {
        "intent": {"type": "number", "minimum": 0, "maximum": 1},
        "primary_goal": {"type": "number", "minimum": 0, "maximum": 1},
        "risk": {"type": "number", "minimum": 0, "maximum": 1},
        "blast_radius": {"type": "number", "minimum": 0, "maximum": 1},
        "scope": {"type": "number", "minimum": 0, "maximum": 1},
        "capabilities": {"type": "number", "minimum": 0, "maximum": 1},
        "architecture_impact": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "overall_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {
      "type": "object",
      "required": ["classifier_version", "prompt_hash", "schema_version", "provider", "model", "resolution_source", "policy_version", "detector_version", "wrapper_version"],
      "properties": {
        "classifier_version": {"type": "string"},
        "prompt_hash": {"type": "string"},
        "schema_version": {"type": "string"},
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "resolution_source": {"type": "string"},
        "policy_version": {"type": "string"},
        "detector_version": {"type": "string"},
        "wrapper_version": {"type": "string"}
      }
    }
  }
}
