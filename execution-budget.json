{
  "schema_version": "1.0.0",
  "profile": "pilot",
  "limits": {
    "max_active_sessions": 1,
    "max_queue_depth": 1,
    "max_retries_per_task": 2,
    "max_total_retries": 8,
    "max_duration_ms": 1800000,
    "max_estimated_tokens": 120000,
    "max_external_api_calls": 40
  },
  "actions": {
    "on_threshold": "pause-for-approval",
    "on_hard_limit": "stop-safely"
  },
  "notes": "Pilot defaults are static safeguards. Runtime telemetry and operator approval remain required before live use."
}
