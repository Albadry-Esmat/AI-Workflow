# S1 portable install set helpers (Q5 non-destructive merge semantics).
INIT_ADDED=0
INIT_KEPT=0
INIT_CONFLICTS=()
init_install_file() {
  # $1 source (must exist), $2 dest — missing:add, identical:keep, different:conflict.
  local src="$1" dst="$2"
  mkdir -p "$(dirname "$dst")"
  if [[ ! -e "$dst" ]]; then
    cp "$src" "$dst"
    INIT_ADDED=$((INIT_ADDED+1))
  elif cmp -s "$src" "$dst"; then
    INIT_KEPT=$((INIT_KEPT+1))
  else
    INIT_CONFLICTS+=("$dst")
  fi
}

init_install_tree() {
  # $1 source dir, $2 dest dir — per-file add/keep/conflict (never deletes).
  local src_dir="$1" dst_dir="$2" f rel
  while IFS= read -r f; do
    rel="${f#$src_dir/}"
    if [[ -L "$f" ]]; then
      local link_target dest_link
      link_target="$(readlink "$f")"
      dest_link="$dst_dir/$rel"
      mkdir -p "$(dirname "$dest_link")"
      if [[ ! -e "$dest_link" && ! -L "$dest_link" ]]; then
        ln -s "$link_target" "$dest_link"
        INIT_ADDED=$((INIT_ADDED+1))
      elif [[ -L "$dest_link" && "$(readlink "$dest_link")" == "$link_target" ]]; then
        INIT_KEPT=$((INIT_KEPT+1))
      else
        INIT_CONFLICTS+=("$dest_link")
      fi
    elif [[ -f "$f" ]]; then
      init_install_file "$f" "$dst_dir/$rel"
    fi
  done < <(find "$src_dir" -mindepth 1 \( -type f -o -type l \) 2>/dev/null | sort)
}

init_explain_mcp_conflict() {
  # $1 source (AIW repo), $2 dest (target) — S2-C merge-assist: explain an MCP
  # projection conflict per server (added/missing/differing IDs only, never
  # values), then the caller still fails closed. Never merges automatically.
  local src="$1" dst="$2" rel="$3"
  node -e "
    const fs = require('fs');
    const [src, dst, rel] = process.argv.slice(1);
    let a, b;
    try { a = JSON.parse(fs.readFileSync(src, 'utf8')); b = JSON.parse(fs.readFileSync(dst, 'utf8')); }
    catch { console.log('    ' + rel + ': unreadable as JSON — manual review required'); process.exit(0); }
    const pick = (o) => (o && typeof o === 'object') ? (o.mcpServers || o.servers || o.mcp || {}) : {};
    const A = pick(a), B = pick(b);
    const ka = new Set(Object.keys(A)), kb = new Set(Object.keys(B));
    const added = [...ka].filter(k => !kb.has(k)).sort();
    const missing = [...kb].filter(k => !ka.has(k)).sort();
    const differing = [...ka].filter(k => kb.has(k) && JSON.stringify(A[k]) !== JSON.stringify(B[k])).sort();
    console.log('    ' + rel + ':');
    if (added.length) console.log('      AIW adds servers: ' + added.join(', '));
    if (missing.length) console.log('      target-only servers (kept): ' + missing.join(', '));
    if (differing.length) console.log('      differing servers (kept target version): ' + differing.join(', '));
    if (!added.length && !missing.length && !differing.length) console.log('      same server set, formatting differs');
  " "$src" "$dst" "$rel"
}

cmd_init() {
  # S1 runtime-neutral init. Installs the portable core + selected runtime
  # projections. Default is fail-closed on any pre-existing install-set path;
  # --merge adds missing entries, keeps identical ones, and still fails on
  # differing ones. Never overwrites, never copies secrets.
  local TARGET="" FOR_LIST="" MERGE="0"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --for) FOR_LIST="$FOR_LIST $2"; shift 2 ;;
      --for=*) FOR_LIST="$FOR_LIST ${1#--for=}"; shift ;;
      --merge) MERGE="1"; shift ;;
      -h|--help)
        echo "Usage: aiw init <path> [--for runtime|auto|all] [--merge]"
        echo "  Installs the portable core (.agents/skills/, AGENTS.md, skills/,"
        echo "  config/mcp-manifest.json) plus runtime projections for --for."
        echo "  Default refuses to touch existing paths; --merge adds missing,"
        echo "  keeps identical, and fails on differing entries (MCP conflicts"
        echo "  print a per-server explanation first). Never copies secrets."
        return 0 ;;
      *) TARGET="$1"; shift ;;
    esac
  done
  if [[ -z "$TARGET" ]]; then
    echo -e "${RED}Error:${NC} specify a target project directory."
    echo "  Usage: aiw init /path/to/your-project [--for runtime|auto|all] [--merge]"
    exit 1
  fi

  TARGET="$(cd "$TARGET" 2>/dev/null && pwd)" || {
    echo -e "${RED}Error:${NC} directory not found: $TARGET"
    exit 1
  }

  echo ""
  echo -e "  ${BOLD}AI Workflow — Init into project${NC}"
  echo -e "  Target: ${CYAN}$TARGET${NC}"
  echo ""

  # Guard: don't init into itself
  if [[ "$TARGET" == "$ROOT" ]]; then
    echo -e "${RED}Error:${NC} target cannot be the AI Workflow directory itself."
    exit 1
  fi

  # Resolve --for set (default: auto).
  local WANT
  WANT="$(echo "$FOR_LIST" | tr ' ' '\n' | grep -v '^$' | sort -u | tr '\n' ' ')"
  [[ -z "${WANT// }" ]] && WANT="auto"
  local RUNTIMES=""
  if [[ "$WANT" == *"all"* ]]; then
    RUNTIMES="opencode claude-code cursor copilot-cli codex gemini-cli cursor-ide vscode-copilot"
  elif [[ "$WANT" == *"auto"* ]]; then
    RUNTIMES="$("$PYTHON_BIN" "$ROOT/scripts/onboarding-o2.py" agent-marker-scan --target "$TARGET" 2>/dev/null || echo "")"
    if [[ -z "${RUNTIMES// }" ]]; then
      echo -e "  ${DIM}No incumbent runtime markers in target — installing portable core only.${NC}"
      echo -e "  ${DIM}Add a runtime later: aiw init $TARGET --for <runtime> --merge${NC}"
    fi
  else
    RUNTIMES="$WANT"
  fi
  # Validate requested IDs against the catalog (unknown IDs fail closed here,
  # so a typo can never silently install the wrong runtime set).
  local UNKNOWN
  UNKNOWN="$(node -e "
    const cat = JSON.parse(require('fs').readFileSync('$ROOT/config/agent-runtime-catalog.json','utf8'));
    const ids = new Set(cat.adapters.map(a => a.id));
    console.log('$RUNTIMES'.split(' ').filter(Boolean).filter(id => !ids.has(id)).join(' '));
  ")"
  if [[ -n "${UNKNOWN// }" ]]; then
    echo -e "${RED}Error:${NC} unknown runtime(s) in --for: $UNKNOWN"
    exit 1
  fi
  echo -e "  Runtimes: ${CYAN}${RUNTIMES:-portable core only}${NC}"

  # Build install set: portable core always; runtime files per selection.
  INIT_ADDED=0
  INIT_KEPT=0
  INIT_CONFLICTS=()
  local PLAN_FILES=()
  local PLAN_TREES=()
  # Portable core (always).
  PLAN_TREES+=(".agents/skills:.agents/skills" "skills:skills")
  PLAN_FILES+=("AGENTS.md:AGENTS.md" "config/mcp-manifest.json:config/mcp-manifest.json" "config/mcp-manifest-schema.json:config/mcp-manifest-schema.json")
  local r
  for r in $RUNTIMES; do
    case "$r" in
      opencode)
        PLAN_FILES+=("opencode.json:opencode.json" ".opencode/package.json:.opencode/package.json" ".opencode/package-lock.json:.opencode/package-lock.json")
        PLAN_TREES+=(".opencode/agent:.opencode/agent" ".opencode/plugins:.opencode/plugins") ;;
      claude-code) PLAN_FILES+=(".mcp.json:.mcp.json") ;;
      cursor) PLAN_FILES+=(".cursor/mcp.json:.cursor/mcp.json") ;;
      copilot-cli) PLAN_FILES+=(".mcp.json:.mcp.json") ;;
      codex|gemini-cli) echo -e "  ${DIM}Note: $r has no file projections yet (catalog declares S2 target); core only.${NC}" ;;
      cursor-ide) PLAN_FILES+=(".cursor/mcp.json:.cursor/mcp.json") ;;
      vscode-copilot) PLAN_FILES+=(".vscode/mcp.json:.vscode/mcp.json") ;;
      windsurf-devin) echo -e "  ${DIM}Note: $r has no project-scoped MCP projection (user-global only, AIW never writes outside the repo); core only.${NC}" ;;
      *) echo -e "  ${DIM}Note: $r (generic) installs portable core only.${NC}" ;;
    esac
  done
  # Dedupe plan entries (claude+copilot share .mcp.json).
  PLAN_FILES=($(printf "%s\n" "${PLAN_FILES[@]}" | sort -u))
  PLAN_TREES=($(printf "%s\n" "${PLAN_TREES[@]}" | sort -u))

  # Default (no --merge): fail closed if ANY install-set path already exists.
  if [[ "$MERGE" != "1" ]]; then
    local EXISTING=()
    local entry src rel
    for entry in "${PLAN_FILES[@]}"; do
      rel="${entry#*:}"
      [[ -e "$TARGET/$rel" || -L "$TARGET/$rel" ]] && EXISTING+=("$rel")
    done
    for entry in "${PLAN_TREES[@]}"; do
      rel="${entry#*:}"
      [[ -e "$TARGET/$rel" || -L "$TARGET/$rel" ]] && EXISTING+=("$rel/")
    done
    if [[ "${#EXISTING[@]}" -gt 0 ]]; then
      echo -e "${RED}Error:${NC} refusing to touch existing paths (non-destructive default):"
      printf "    %s\n" "${EXISTING[@]}"
      echo "  Re-run with --merge to add missing entries (differing entries still fail),"
      echo "  or remove the paths above first."
      exit 1
    fi
  fi

  # Install per-entry add/keep/conflict (Q5).
  local entry src rel
  for entry in "${PLAN_FILES[@]}"; do
    src="${entry%%:*}"
    rel="${entry#*:}"
    if [[ ! -e "$ROOT/$src" && ! -L "$ROOT/$src" ]]; then
      echo -e "${YELLOW}Warning:${NC} source missing in AIW repo, skipping: $src"
      continue
    fi
    init_install_file "$ROOT/$src" "$TARGET/$rel"
  done
  for entry in "${PLAN_TREES[@]}"; do
    src="${entry%%:*}"
    rel="${entry#*:}"
    if [[ -L "$ROOT/$src" ]]; then
      init_install_file "$ROOT/$src" "$TARGET/$rel"
    else
      init_install_tree "$ROOT/$src" "$TARGET/$rel"
    fi
  done
  # Claude links are regenerated, never copied as physical dirs: recreate the
  # farm in the target so links resolve inside the target project.
  if [[ "$RUNTIMES" == *"claude-code"* ]]; then
    local skill link_target
    while IFS= read -r skill; do
      skill="$(basename "$skill")"
      link_target="../../.agents/skills/$skill"
      if [[ ! -e "$TARGET/.claude/skills/$skill" && ! -L "$TARGET/.claude/skills/$skill" ]]; then
        mkdir -p "$TARGET/.claude/skills"
        ln -s "$link_target" "$TARGET/.claude/skills/$skill"
        INIT_ADDED=$((INIT_ADDED+1))
      elif [[ -L "$TARGET/.claude/skills/$skill" && "$(readlink "$TARGET/.claude/skills/$skill")" == "$link_target" ]]; then
        INIT_KEPT=$((INIT_KEPT+1))
      else
        INIT_CONFLICTS+=(".claude/skills/$skill")
      fi
    done < <(find "$ROOT/.agents/skills" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort)
  fi

  if [[ "${#INIT_CONFLICTS[@]}" -gt 0 ]]; then
    echo -e "${RED}Error:${NC} conflicting entries (kept user-owned files untouched):"
    printf "    %s\n" "${INIT_CONFLICTS[@]}"
    # S2-C merge-assist: explain MCP projection conflicts per server (never values).
    local conflicted rel entry entry_src
    for conflicted in "${INIT_CONFLICTS[@]}"; do
      rel="${conflicted#$TARGET/}"
      case "$rel" in
        .mcp.json|.cursor/mcp.json|.vscode/mcp.json|opencode.json)
          entry_src=""
          for entry in "${PLAN_FILES[@]}"; do
            [[ "${entry#*:}" == "$rel" ]] && entry_src="${entry%%:*}"
          done
          if [[ -n "$entry_src" && -f "$ROOT/$entry_src" && -f "$TARGET/$rel" ]]; then
            init_explain_mcp_conflict "$ROOT/$entry_src" "$TARGET/$rel" "$rel"
          fi
          ;;
      esac
    done
    echo "  Resolve manually, then re-run with --merge."
    exit 1
  fi
  echo "  Installed: $INIT_ADDED added, $INIT_KEPT unchanged."

  # Install plugin deps in the target (opencode only).
  if [[ "$RUNTIMES" == *"opencode"* && -f "$TARGET/.opencode/package.json" ]]; then
    echo "  Installing .opencode/ plugin dependencies..."
    npm install --prefix "$TARGET/.opencode" --silent
  fi

  # Never propagate populated secrets into another project. Provision only the
  # template and require the target owner to configure credentials explicitly.
  if [[ ! -f "$TARGET/.env" ]]; then
    if [[ ! -f "$ROOT/.env.example" ]]; then
      echo -e "${RED}Error:${NC} $ROOT/.env.example not found — cannot create target .env."
      exit 1
    fi
    cp "$ROOT/.env.example" "$TARGET/.env"
    chmod 600 "$TARGET/.env"
    echo -e "  ${YELLOW}Created target .env from template — set credentials manually.${NC}"
    if [[ -f "$ROOT/.env" ]]; then
      echo -e "  ${YELLOW}Source .env was intentionally not copied because it may contain secrets.${NC}"
    fi
  else
    echo "  .env already exists in target — skipped."
  fi

  echo ""
  echo -e "  ${GREEN}Done!${NC} AI Workflow is ready in:"
  echo -e "  ${CYAN}$TARGET${NC}"
  echo ""
  echo "  Installed: portable core (.agents/skills/, AGENTS.md, skills/, MCP manifest)"
  echo "  Runtimes: ${RUNTIMES:-none (core only)}"
  echo ""
  echo "  To use it:"
  echo "    aiw start $TARGET --for auto"
  echo ""
}

