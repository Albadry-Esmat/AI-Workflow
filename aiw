cmd_start() {
  if ! command -v opencode &>/dev/null; then
    echo -e "${RED}Error:${NC} opencode is not installed."
    echo "  Install it from: https://opencode.ai"
    exit 1
  fi

  # Optional: path to a target project
  local TARGET="${1:-}"
  if [[ -n "$TARGET" ]]; then
    # Resolve to absolute path
    TARGET="$(cd "$TARGET" 2>/dev/null && pwd)" || {
      echo -e "${RED}Error:${NC} directory not found: $1"
      exit 1
    }
    echo -e "${GREEN}Starting AI Workflow...${NC}"
    echo -e "${DIM}Target project: $TARGET${NC}"
    echo -e "${DIM}Agents + skills from: $ROOT${NC}"
    echo -e "${DIM}Type a request to begin. Example: \"review code in src/\"${NC}"
    echo ""
    # Must run from ROOT so opencode.json and .opencode/ are found,
    # but pass the target project path so opencode's file tools use it.
    cd "$ROOT"
    opencode "$TARGET"
  else
    echo ""
    echo -e "  ${BOLD}AI Workflow${NC} — ready."
    echo ""
    echo -e "  ${CYAN}Working on this repo?${NC}"
    echo -e "  Just start typing — the agents will read and edit files here."
    echo ""
    echo -e "  ${CYAN}Working on a different project?${NC}"
    echo -e "  ${BOLD}aiw start /path/to/your-project${NC}   ← agents work on that project's files"
    echo -e "  ${BOLD}aiw init  /path/to/your-project${NC}   ← install workflow into that project permanently"
    echo ""
    echo -e "  ${DIM}Examples:${NC}"
    echo -e "  ${DIM}  aiw start ~/Projects/my-app${NC}"
    echo -e "  ${DIM}  aiw start .  (current directory, same as no argument)${NC}"
    echo ""
    cd "$ROOT"
    opencode
  fi
}

