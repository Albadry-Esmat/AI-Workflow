  demo)             cmd_demo "$@" ;;
  agent)            cmd_agent "$@" ;;
  auth)             cmd_auth "$@" ;;
  recover)          cmd_recover "$@" ;;
  skill)            cmd_skill "$@" ;;
  feedback-to-eval) cmd_feedback_to_eval "$@" ;;
  autonomy-experiments) cmd_autonomy_experiments "$@" ;;
  consolidation-analysis) cmd_consolidation_analysis "$@" ;;
  operational-evidence) cmd_operational_evidence "$@" ;;
  measure-slos) cmd_measure_slos "$@" ;;
  evaluate-model-compatibility) cmd_evaluate_model_compatibility "$@" ;;
