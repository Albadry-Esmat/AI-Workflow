}

cmd_onboarding() {
  local subcmd="${1:-plan}"
  shift || true
  case "$subcmd" in
    install-plan|install-verify|install)
      "$PYTHON_BIN" "$ROOT/scripts/onboarding-o4.py" "$subcmd" "$@"
      ;;
    execute-plan|artifact-hash|execute)
      "$PYTHON_BIN" "$ROOT/scripts/onboarding-o5.py" "$subcmd" "$@"
      ;;
    attestation-plan|attestation-verify)
      "$PYTHON_BIN" "$ROOT/scripts/onboarding-o6.py" "$subcmd" "$@"
      ;;
    verifier-plan|verifier-verify|verifier-refresh-plan|verifier-refresh)
      "$PYTHON_BIN" "$ROOT/scripts/onboarding-o7.py" "$subcmd" "$@"
      ;;
    recover)
      if [[ " $* " == *" --o7 "* ]]; then
        local filtered_o7=()
        for arg in "$@"; do
          [[ "$arg" == "--o7" ]] || filtered_o7+=("$arg")
        done
        "$PYTHON_BIN" "$ROOT/scripts/onboarding-o7.py" recover "${filtered_o7[@]}"
      elif [[ " $* " == *" --o6 "* ]]; then
        local filtered_o6=()
        for arg in "$@"; do
          [[ "$arg" == "--o6" ]] || filtered_o6+=("$arg")
        done
        "$PYTHON_BIN" "$ROOT/scripts/onboarding-o6.py" recover "${filtered_o6[@]}"
      elif [[ " $* " == *" --o5 "* ]]; then
        local filtered_o5=()
        for arg in "$@"; do
          [[ "$arg" == "--o5" ]] || filtered_o5+=("$arg")
        done
        "$PYTHON_BIN" "$ROOT/scripts/onboarding-o5.py" recover "${filtered_o5[@]}"
      elif [[ " $* " == *" --o4 "* ]]; then
        local filtered_o4=()
        for arg in "$@"; do
          [[ "$arg" == "--o4" ]] || filtered_o4+=("$arg")
        done
        "$PYTHON_BIN" "$ROOT/scripts/onboarding-o4.py" recover "${filtered_o4[@]}"
      else
        "$PYTHON_BIN" "$ROOT/scripts/onboarding-o3.py" recover "$@"
      fi
      ;;
    plan|apply|doctor)
      "$PYTHON_BIN" "$ROOT/scripts/onboarding-o3.py" "$subcmd" "$@"
      ;;
    *)
      echo "Usage: aiw onboarding [plan|apply|doctor|recover [--o4|--o5|--o6|--o7]|install-plan|install-verify|install|execute-plan|artifact-hash|execute|attestation-plan|attestation-verify|verifier-plan|verifier-verify|verifier-refresh-plan|verifier-refresh]"
      return 2
      ;;
  esac
}

