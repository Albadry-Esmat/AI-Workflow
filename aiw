cmd_start() {
  # S1 runtime-neutral dispatcher. Never requires opencode unless selected.
  # Model invariant: no model flags are ever passed (runtime inheritance).
  # Test hook: AIW_EXEC_DRY_RUN=1 prints argv instead of executing.
  local FOR="auto"
  local TARGET=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --for) FOR="${2:-auto}"; shift 2 ;;
      --for=*) FOR="${1#--for=}"; shift ;;
      -h|--help)
        echo "Usage: aiw start [path] [--for runtime|auto]"
        echo "  Resolves a runtime (explicit --for, persisted selection, project markers,"
        echo "  installed runtimes, generic command) and launches it on the target."
        echo "  No model override is ever passed; the runtime uses its own selection."
        return 0 ;;
      *) TARGET="$1"; shift ;;
    esac
  done

  local TARGET_DIR="$ROOT"
  local TARGET_GIVEN=0
  if [[ -n "$TARGET" ]]; then
    TARGET_DIR="$(cd "$TARGET" 2>/dev/null && pwd)" || {
      echo -e "${RED}Error:${NC} directory not found: $TARGET"
      exit 1
    }
    TARGET_GIVEN=1
  fi

  # 1. Resolve runtime (fail closed; never falls back silently).
  # Dry-run: aiw start never persists selection (persistence belongs to
  # aiw agent use; per-target auto results must not overwrite the AIW default).
  local RESOLVE_JSON
  RESOLVE_JSON="$("$PYTHON_BIN" "$ROOT/scripts/onboarding-o2.py" agent-resolve --target "$TARGET_DIR" --for "$FOR" --dry-run --json 2>/dev/null)" || true
  if [[ -z "$RESOLVE_JSON" ]]; then
    echo -e "${RED}Error:${NC} runtime resolution produced no output (python3 required for selection)."
    exit 1
  fi
  local VERDICT ADAPTER_ID LAUNCH_KIND
  VERDICT="$(node -e "console.log((JSON.parse(require('fs').readFileSync(0,'utf8')).verdict)||'')" <<<"$RESOLVE_JSON")"
  if [[ "$VERDICT" != "pass" ]]; then
    node -e "
      const r = JSON.parse(require('fs').readFileSync(0,'utf8'));
      console.log('Runtime resolution failed [' + (r.error_code||'unknown') + ']');
      if (r.warning) console.log('  Warning: ' + r.warning);
      if (r.candidates) console.log('  Choices: ' + r.candidates.join(', '));
      if (r.guidance) console.log('  ' + r.guidance);
    " <<<"$RESOLVE_JSON"
    exit 1
  fi
  ADAPTER_ID="$(node -e "console.log(JSON.parse(require('fs').readFileSync(0,'utf8')).adapter_id)" <<<"$RESOLVE_JSON")"
  LAUNCH_KIND="$(node -e "
    const cat = JSON.parse(require('fs').readFileSync('$ROOT/config/agent-runtime-catalog.json','utf8'));
    const a = cat.adapters.find(x => x.id === '$ADAPTER_ID') || {};
    console.log(a.launch_kind || 'cli-direct');
  ")"

  # 2. MCP freshness (global, all adapters) + required dependencies per
  # MCP-surface adapter (S2-B strict: opencode, claude-code, copilot-cli,
  # cursor, cursor-ide, vscode-copilot). Q4 fail-closed start.
  if ! node "$ROOT/scripts/sync-mcp.js" --check >/dev/null 2>&1; then
    echo -e "${RED}Error:${NC} MCP projections are stale for the selected runtime."
    echo "  Remediation: aiw sync-runtimes   (refusing to launch on known-differing config)"
    exit 1
  fi
  case "$ADAPTER_ID" in
    opencode|claude-code|copilot-cli|cursor|cursor-ide|vscode-copilot)
      MCP_DEPS_OUT="$(node "$ROOT/scripts/check-mcp-deps.js" --adapter "$ADAPTER_ID" --strict 2>&1)" || {
        echo "$MCP_DEPS_OUT"
        echo -e "${RED}Error:${NC} required MCP dependencies unusable — start blocked."
        exit 1
      }
      [[ -n "$MCP_DEPS_OUT" ]] && echo "$MCP_DEPS_OUT"
      ;;
    *)
      echo -e "${DIM}No MCP surface declared for '$ADAPTER_ID' — continuing without MCP gates.${NC}"
      ;;
  esac

  # 3. Launch (CLI / verified IDE opener) or guide (IDE). No model flags, ever.
  if [[ "$LAUNCH_KIND" == "ide-guidance" ]]; then
    cmd_start_guidance "$ADAPTER_ID" "$TARGET_DIR"
    return 0
  fi
  if [[ "$LAUNCH_KIND" == "opener-launch" ]]; then
    local RESOLVE_LAUNCH RESOLVE_OPENER VERIFIED_OPENERS
    RESOLVE_LAUNCH="$(node -e "console.log(JSON.parse(require('fs').readFileSync(0,'utf8')).launch||'')" <<<"$RESOLVE_JSON")"
    RESOLVE_OPENER="$(node -e "console.log(JSON.parse(require('fs').readFileSync(0,'utf8')).opener||'')" <<<"$RESOLVE_JSON")"
    VERIFIED_OPENERS="$(node -e "
      const cat = JSON.parse(require('fs').readFileSync('$ROOT/config/agent-runtime-catalog.json','utf8'));
      const a = cat.adapters.find(x => x.id === '$ADAPTER_ID') || {};
      console.log(((a.openers || []).filter(o => o.verified) || []).map(o => o.executable).join(' '));
    ")"
    # Fail-safe: resolve verdict AND catalog must agree on a verified, installed opener.
    if [[ "$RESOLVE_LAUNCH" == "opener-launch" && -n "$RESOLVE_OPENER" ]]; then
      local opener_ok=0
      for candidate in $VERIFIED_OPENERS; do
        if [[ "$candidate" == "$RESOLVE_OPENER" ]] && command -v "$RESOLVE_OPENER" &>/dev/null; then
          opener_ok=1
          break
        fi
      done
      if [[ "$opener_ok" -eq 1 ]]; then
        echo -e "${GREEN}Starting AI Workflow...${NC} ${DIM}(runtime: $ADAPTER_ID via opener: $RESOLVE_OPENER)${NC}"
        echo -e "${DIM}Target project: $TARGET_DIR${NC}"
        if [[ -n "${AIW_EXEC_DRY_RUN:-}" ]]; then
          echo "DRY-RUN argv: [$ADAPTER_ID] CWD=$TARGET_DIR CMD=$RESOLVE_OPENER $TARGET_DIR"
          return 0
        fi
        cd "$TARGET_DIR"
        exec "$RESOLVE_OPENER" "$TARGET_DIR"
      fi
    fi
    cmd_start_guidance "$ADAPTER_ID" "$TARGET_DIR"
    return 0
  fi

  local LAUNCH_CMD
  LAUNCH_CMD="$(node -e "
    const cat = JSON.parse(require('fs').readFileSync('$ROOT/config/agent-runtime-catalog.json','utf8'));
    console.log((cat.adapters.find(x => x.id === '$ADAPTER_ID') || {}).launch.command || '');
  ")"
  if [[ -z "$LAUNCH_CMD" || "$LAUNCH_CMD" == "external-launch-required" ]]; then
    cmd_start_guidance "$ADAPTER_ID" "$TARGET_DIR"
    return 0
  fi

  echo -e "${GREEN}Starting AI Workflow...${NC} ${DIM}(runtime: $ADAPTER_ID)${NC}"
  echo -e "${DIM}Target project: $TARGET_DIR${NC}"
  if [[ -n "${AIW_EXEC_DRY_RUN:-}" ]]; then
    echo "DRY-RUN argv: [$ADAPTER_ID] CWD=$TARGET_DIR CMD=$LAUNCH_CMD"
    return 0
  fi
  if [[ "$ADAPTER_ID" == "opencode" ]]; then
    # Preserve legacy behavior: run from ROOT, pass target positionally.
    cd "$ROOT"
    if [[ "$TARGET_GIVEN" -eq 1 ]]; then
      exec opencode "$TARGET_DIR"
    else
      exec opencode
    fi
  elif [[ "$ADAPTER_ID" == "generic-command" ]]; then
    if [[ -z "${AIW_AGENT_COMMAND:-}" ]]; then
      echo -e "${RED}Error:${NC} AIW_AGENT_COMMAND is not set for generic-command."
      exit 1
    fi
    cd "$TARGET_DIR"
    # shellcheck disable=SC2086
    exec $AIW_AGENT_COMMAND
  else
    cd "$TARGET_DIR"
    case "$ADAPTER_ID" in
      claude-code) exec claude ;;
      codex) exec codex ;;
      cursor) exec agent ;;
      copilot-cli) exec copilot ;;
      gemini-cli) exec gemini ;;
      aider) exec aider ;;
      antigravity) exec agy ;;
      *) echo -e "${RED}Error:${NC} no verified launch command for '$ADAPTER_ID'."; exit 1 ;;
    esac
  fi
}

cmd_start_guidance() {
  # $1 adapter_id, $2 target dir — IDE-only runtimes: guidance, best-effort opener.
  local ADAPTER_ID="$1" TARGET_DIR="$2"
  local DISPLAY OPENER
  DISPLAY="$(node -e "console.log((JSON.parse(require('fs').readFileSync('$ROOT/config/agent-runtime-catalog.json','utf8')).adapters.find(x => x.id === '$ADAPTER_ID') || {}).display_name || '$ADAPTER_ID')")"
  OPENER="$(node -e "
    const cat = JSON.parse(require('fs').readFileSync('$ROOT/config/agent-runtime-catalog.json','utf8'));
    const a = cat.adapters.find(x => x.id === '$ADAPTER_ID') || {};
    const ok = (a.openers || []).filter(o => o.verified).map(o => o.executable);
    console.log(ok.join(' '));
  ")"
  echo ""
  echo -e "  ${BOLD}AI Workflow${NC} — configured for ${CYAN}$DISPLAY${NC} (IDE runtime)."
  echo ""
  echo -e "  Portable core installed at: ${CYAN}$TARGET_DIR${NC}"
  echo -e "  Skills: ${CYAN}$TARGET_DIR/.agents/skills/${NC}  •  Instructions: ${CYAN}$TARGET_DIR/AGENTS.md${NC}"
  echo ""
  for candidate in $OPENER; do
    if command -v "$candidate" &>/dev/null; then
      echo -e "  Opening project with ${CYAN}$candidate${NC} ..."
      "$candidate" "$TARGET_DIR" &
      return 0
    fi
  done
  echo -e "  ${DIM}External launch required: open $TARGET_DIR in $DISPLAY yourself.${NC}"
  echo ""
}

