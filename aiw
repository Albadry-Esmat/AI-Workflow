set -euo pipefail

# Resolve project root — handles symlinks, relative paths, and macOS readlink
_resolve_script_path() {
  local src="${BASH_SOURCE[0]}"
  # Follow symlinks until we reach the real file
  while [[ -L "$src" ]]; do
    local link
    link="$(readlink "$src")"
    if [[ "$link" = /* ]]; then
      src="$link"
    else
      src="$(cd "$(dirname "$src")" && pwd)/$link"
    fi
  done
  echo "$(cd "$(dirname "$src")" && pwd)"
}
ROOT="$(_resolve_script_path)"

