{
  "name": "ai-workflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "health": "bash scripts/health-check.sh",
    "validate": "./aiw validate",
    "validate:semantic": "node scripts/validate-pipelines.js",
    "clean": "bash scripts/clean.sh",
    "reset": "bash scripts/reset.sh",
    "sync": "bash scripts/sync-website-data.sh",
    "website": "bash rebuild.sh",
    "sessions": "bash scripts/cleanup-sessions.sh",
    "sessions:delete": "bash scripts/cleanup-sessions.sh --delete",
    "update": "./aiw update",
    "graph": "graphify update .",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --ci",
    "self-test": "node scripts/self-test.js",
    "preflight": "node scripts/preflight.js",
    "support-bundle": "node scripts/support-bundle.js",
    "security:history": "node scripts/security-check.js --history"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
