{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ase-os/schemas/agent-runtime-adapter.json",
  "title": "AgentRuntimeAdapterCatalog",
  "description": "Provider-neutral AI-agent runtime adapter contract for Onboarding Batch O0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "adapters"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "adapters": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/definitions/adapter"}
    }
  },
  "definitions": {
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "display_name", "vendor", "status", "support_level",
        "documentation", "detection", "installation", "authentication",
        "project_context", "launch", "safety", "evidence", "recovery", "capabilities"
      ],

      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "display_name": {"type": "string", "minLength": 1},
        "vendor": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["planned", "active", "deprecated", "disabled"]},
        "support_level": {"type": "string", "enum": ["first-class", "compatible", "generic", "candidate"]},
        "documentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["official_url", "reviewed_at", "verification_state"],
          "properties": {
            "official_url": {"type": "string", "format": "uri"},
            "reviewed_at": {"type": "string", "format": "date"},
            "verification_state": {"type": "string", "enum": ["documentation-reviewed", "fixture-pending", "fixture-verified", "unknown"]}
          }
        },
        "detection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "version_args", "safe_probe", "version_output_required"],
          "properties": {
            "executable": {"type": "string", "minLength": 1},
            "version_args": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "safe_probe": {"type": "boolean", "const": true},
            "version_output_required": {"type": "boolean", "const": true}
          }
        },
        "installation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["managed_by_aiw", "requires_explicit_consent", "channels"],
          "properties": {
            "managed_by_aiw": {"type": "boolean", "const": false},
            "requires_explicit_consent": {"type": "boolean", "const": true},
            "channels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "name", "user_action_required"],
                "properties": {
                  "kind": {"type": "string", "enum": ["native-installer", "package-manager", "binary", "container", "user-managed"]},
                  "name": {"type": "string", "minLength": 1},
                  "user_action_required": {"type": "boolean", "const": true}
                }
              }
            }
          }
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_for_start", "modes", "credential_owner", "aiw_handles_secret_values", "status_probe"],
          "properties": {
            "required_for_start": {"type": "boolean"},
            "modes": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["browser-device", "runtime-login", "external-cli", "api-key-env", "enterprise-gateway", "none"]}},
            "credential_owner": {"type": "string", "enum": ["runtime", "provider", "github-cli", "user", "none"]},
            "aiw_handles_secret_values": {"type": "boolean", "const": false},
            "status_probe": {"type": "string", "enum": ["adapter-status", "runtime-status", "external-cli-status", "none"]}
          }
        },
        "project_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_directory_required", "initialization_required", "configuration_owner", "secret_copy_allowed"],
          "properties": {
            "target_directory_required": {"type": "boolean", "const": true},
            "initialization_required": {"type": "boolean"},
            "configuration_owner": {"type": "string", "enum": ["aiw", "runtime", "target-project", "user"]},
            "secret_copy_allowed": {"type": "boolean", "const": false}
          }
        },
        "launch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "target_cwd", "neutral_start_supported", "explicit_agent_selection_supported"],
          "properties": {
            "command": {"type": "string", "minLength": 1},
            "target_cwd": {"type": "boolean", "const": true},
            "neutral_start_supported": {"type": "boolean", "const": true},
            "explicit_agent_selection_supported": {"type": "boolean", "const": true}
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan_or_review_mode", "approval_model", "external_write_claim", "fallback_behavior"],
          "properties": {
            "plan_or_review_mode": {"type": "string", "enum": ["native", "mapped", "unknown", "none"]},
            "approval_model": {"type": "string", "enum": ["native", "mapped", "unknown", "none"]},
            "external_write_claim": {"type": "string", "enum": ["declared-by-adapter", "not-claimed", "unknown"]},
            "fallback_behavior": {"type": "string", "enum": ["fail-closed", "explicit-generic", "unknown"]}
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_manifest_adapter_id", "events", "evidence_level", "external_writes_default"],
          "properties": {
            "run_manifest_adapter_id": {"type": "boolean", "const": true},
            "events": {"type": "array", "minItems": 3, "items": {"type": "string", "enum": ["detected", "selected", "authenticated", "started", "completed", "failed", "cancelled"]}},
            "evidence_level": {"type": "string", "enum": ["full", "partial", "launch-only", "none"]},
            "external_writes_default": {"type": "boolean", "const": false}
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supports_cancel", "supports_resume", "supports_undo", "rollback_claim"],
          "properties": {
            "supports_cancel": {"type": "boolean"},
            "supports_resume": {"type": "boolean"},
            "supports_undo": {"type": "boolean"},
            "rollback_claim": {"type": "string", "enum": ["adapter-verified", "core-only", "not-claimed", "unknown"]}
          }
        },
        "interoperability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skills_path", "instructions_path", "mcp_path", "skills_support"],
          "properties": {
            "skills_path": {"type": "string", "minLength": 1},
            "instructions_path": {"type": "string", "minLength": 1},
            "mcp_path": {"type": "string", "minLength": 1},
            "skills_support": {"type": "string", "enum": ["native", "adapter-required", "generic"]}
          },
          "description": "P0 verified skill/instruction/MCP paths per official runtime docs. skills_support=native means the runtime discovers .agents/skills/ directly; adapter-required (Claude Code) means a generated link farm is maintained; generic means unverified."
        },
        "launch_kind": {
          "type": "string",
          "enum": ["cli-direct", "ide-guidance", "generic"],
          "description": "S1 how aiw start uses this runtime. cli-direct: executed with CWD=target. ide-guidance: never executed; guidance plus best-effort documented opener. generic: user-provided command executed with CWD=target."
        },
        "project_markers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "S1 repository markers mapping a target directory to this runtime (selection layer only, never installation)."
        },
        "openers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["executable", "verified"],
            "properties": {
              "executable": {"type": "string", "minLength": 1},
              "verified": {"type": "boolean"}
            }
          },
          "description": "S1 best-effort GUI project openers for ide-guidance runtimes. Attempted only after a successful probe; absence degrades to guidance, never failure. verified=false means unconfirmed — never attempted."
        },
        "mcp_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "remote_url_field", "env_syntax", "project_scoped"],
          "properties": {
            "path": {"type": ["string", "null"], "description": "S1 generated projection path, or null when S1 generates nothing for this runtime."},
            "future_path": {"type": ["string", "null"], "description": "Declared S2 target; informational only."},
            "remote_url_field": {"type": ["string", "null"], "description": "Remote endpoint field name (url vs serverUrl vs httpUrl)."},
            "env_syntax": {"type": ["string", "null"], "description": "Secret-reference syntax, e.g. ${VAR}, {env:VAR}, ${env:NAME}."},
            "project_scoped": {"type": ["boolean", "null"], "description": "Whether the runtime reads project-level MCP config."},
            "shared_with": {"type": ["array", "null"], "items": {"type": "string"}, "description": "Adapter IDs sharing the same generated file (Q2)."},
            "note": {"type": "string", "description": "Compatibility or scope notes."}
          },
          "description": "S1 declarative MCP projection descriptor. AIW never writes outside the repository."
        },
        "adapter_paths": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agents": {"type": ["string", "null"]},
            "rules": {"type": ["string", "null"]},
            "hooks": {"type": ["string", "null"]}
          },
          "description": "S1 informational runtime-specific paths (agents/rules/hooks). Generation of these is S2 or later; null means n/a."
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan_mode", "approval_gates", "sandboxing", "structured_output", "mcp", "streaming"],
          "properties": {
            "plan_mode": {"type": "string", "enum": ["native", "mapped", "unknown", "unsupported"]},
            "approval_gates": {"type": "string", "enum": ["native", "mapped", "unknown", "unsupported"]},
            "sandboxing": {"type": "string", "enum": ["native", "mapped", "unknown", "unsupported"]},
            "structured_output": {"type": "string", "enum": ["native", "mapped", "unknown", "unsupported"]},
            "mcp": {"type": "string", "enum": ["native", "mapped", "unknown", "unsupported"]},
            "streaming": {"type": "string", "enum": ["native", "mapped", "unknown", "unsupported"]}
          }
        }
      }
    }
  }
}
