{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ase-os/schemas/feedback-eval.json",
  "title": "FeedbackEvalRecord",
  "description": "Human-reviewable feedback-derived evaluation record; only approved records may enter an active corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feedback_id", "skill_name", "source", "task_summary", "expected_properties", "sensitivity_class", "dedup_key", "approval_status", "ingested_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "feedback_id": {"type": "string", "pattern": "^FB-[A-Z0-9-]+$"},
    "skill_name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "source": {"type": "string", "enum": ["human-feedback", "session-review", "evaluation-review"]},
    "task_summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "expected_properties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "sensitivity_class": {"type": "string", "enum": ["public", "internal", "confidential", "restricted"]},
    "dedup_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "approval_status": {"type": "string", "enum": ["pending", "approved", "rejected", "duplicate", "invalid"]},
    "approved_by": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "active_case_path": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"approval_status": {"const": "approved"}}},
      "then": {
        "required": ["approved_by", "approved_at", "active_case_path"],
        "properties": {"approved_by": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "format": "date-time"}, "active_case_path": {"type": "string", "minLength": 1}}
      }
    }
  ]
}
