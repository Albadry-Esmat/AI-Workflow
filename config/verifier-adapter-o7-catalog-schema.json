{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Workflow O7 Verifier Adapter Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "records"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter_id", "vendor", "display_name", "kind", "executable", "argv_template", "verification_modes", "claim_requirements", "network", "evidence", "authority", "status", "record_fingerprint"],
        "properties": {
          "adapter_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"},
          "vendor": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["github-cli", "cosign", "npm-cli", "local-fixture"]},
          "executable": {"type": "string", "minLength": 1},
          "argv_template": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "verification_modes": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["offline-bundle", "offline-key", "online-api", "online-registry"]}},
          "claim_requirements": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_subject", "identity", "issuer", "repository", "signer", "predicate_type", "workflow_or_build", "external_parameters", "unknown_claims"],
            "properties": {
              "artifact_subject": {"type": "boolean"},
              "identity": {"type": "boolean"},
              "issuer": {"type": "boolean"},
              "repository": {"type": "boolean"},
              "signer": {"type": "boolean"},
              "predicate_type": {"type": "boolean"},
              "workflow_or_build": {"type": "boolean"},
              "external_parameters": {"type": "boolean"},
              "unknown_claims": {"type": "string", "enum": ["fail-closed", "warn-only"]}
            }
          },
          "network": {
            "type": "object",
            "additionalProperties": false,
            "required": ["default", "refresh_opt_in", "allowed_hosts", "timeout_seconds", "max_response_bytes", "candidate_root_path", "active_root_overwrite", "evidence_required"],
            "properties": {
              "default": {"type": "string", "enum": ["disabled"]},
              "refresh_opt_in": {"type": "boolean"},
              "allowed_hosts": {"type": "array", "items": {"type": "string", "format": "hostname"}},
              "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
              "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 10485760},
              "candidate_root_path": {"type": "string", "minLength": 1},
              "active_root_overwrite": {"type": "boolean", "const": false},
              "evidence_required": {"type": "boolean", "const": true}
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "json_output", "source_url_required", "response_digest_required", "redacted"],
            "properties": {
              "format": {"type": "string", "enum": ["json", "jsonl"]},
              "json_output": {"type": "boolean", "const": true},
              "source_url_required": {"type": "boolean", "const": true},
              "response_digest_required": {"type": "boolean", "const": true},
              "redacted": {"type": "boolean", "const": true}
            }
          },
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": ["installation", "execution", "authentication", "target_mutations", "launch"],
            "properties": {
              "installation": {"type": "boolean", "const": false},
              "execution": {"type": "boolean", "const": false},
              "authentication": {"type": "string", "enum": ["deferred"]},
              "target_mutations": {"type": "integer", "minimum": 0, "maximum": 0},
              "launch": {"type": "string", "enum": ["deferred"]}
            }
          },
          "status": {"type": "string", "enum": ["research-record", "offline-ready", "online-refresh-optional"]},
          "record_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
