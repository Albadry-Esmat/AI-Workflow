{
  "manifest_version": "1.0.0",
  "servers": {
    "github": {
      "description": "Repository operations for reviewer/deployer agents",
      "enabled": true,
      "required": false,
      "transport": "stdio",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github@2025.4.8"],
      "args": [],
      "url": null,
      "env_refs": {"GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"},
      "headers": {},
      "cwd": null,
      "timeout_ms": 5000,
      "trust": "prompt",
      "compatibility": ["opencode", "claude-code", "cursor", "copilot-cli"]
    },
    "brave-search": {
      "description": "Web search for agents that need current documentation or references",
      "enabled": true,
      "required": false,
      "transport": "stdio",
      "command": ["npx", "-y", "@modelcontextprotocol/server-brave-search@0.6.2"],
      "args": [],
      "url": null,
      "env_refs": {"BRAVE_API_KEY": "${BRAVE_API_KEY}"},
      "headers": {},
      "cwd": null,
      "timeout_ms": 5000,
      "trust": "prompt",
      "compatibility": ["opencode", "claude-code", "cursor", "copilot-cli"]
    },
    "memory": {
      "description": "Persistent cross-session memory for agents",
      "enabled": true,
      "required": false,
      "transport": "stdio",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory@2026.7.4"],
      "args": [],
      "url": null,
      "env_refs": {},
      "headers": {},
      "cwd": null,
      "timeout_ms": 5000,
      "trust": "prompt",
      "compatibility": ["opencode", "claude-code", "cursor", "copilot-cli"]
    },
    "context7": {
      "description": "Up-to-date library documentation inside agent context windows",
      "enabled": true,
      "required": false,
      "transport": "stdio",
      "command": ["npx", "-y", "@upstash/context7-mcp@3.2.2"],
      "args": [],
      "url": null,
      "env_refs": {"CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"},
      "headers": {},
      "cwd": null,
      "timeout_ms": 5000,
      "trust": "prompt",
      "compatibility": ["opencode", "claude-code", "cursor", "copilot-cli"]
    },
    "playwright": {
      "description": "Browser automation for verification and testing agents",
      "enabled": true,
      "required": false,
      "transport": "stdio",
      "command": ["npx", "-y", "@playwright/mcp@0.0.77", "--headless", "--isolated", "--browser", "chromium"],
      "args": [],
      "url": null,
      "env_refs": {},
      "headers": {},
      "cwd": null,
      "timeout_ms": 5000,
      "trust": "prompt",
      "compatibility": ["opencode", "claude-code", "cursor", "copilot-cli"]
    },
    "slack": {
      "description": "Team notifications (disabled by default; enable explicitly per project)",
      "enabled": false,
      "required": false,
      "transport": "stdio",
      "command": ["npx", "-y", "@modelcontextprotocol/server-slack@2025.4.25"],
      "args": [],
      "url": null,
      "env_refs": {"SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}", "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"},
      "headers": {},
      "cwd": null,
      "timeout_ms": 5000,
      "trust": "prompt",
      "compatibility": ["opencode", "claude-code", "cursor", "copilot-cli"]
    },
    "vercel": {
      "description": "Deployment operations for deployer agents (disabled by default)",
      "enabled": false,
      "required": false,
      "transport": "stdio",
      "command": ["npx", "-y", "vercel-mcp@0.0.7"],
      "args": [],
      "url": null,
      "env_refs": {"VERCEL_TOKEN": "${VERCEL_TOKEN}"},
      "headers": {},
      "cwd": null,
      "timeout_ms": 5000,
      "trust": "prompt",
      "compatibility": ["opencode", "claude-code", "cursor", "copilot-cli"]
    }
  }
}
