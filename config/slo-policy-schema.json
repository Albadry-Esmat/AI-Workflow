{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Albadry-Esmat/AI-Workflow/schemas/slo-policy.schema.json",
  "title": "AI-Workflow SLO Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "services", "slos", "error_budget_policy", "burn_rate_rules"],
  "properties": {
    "policy_version": { "type": "string", "const": "1.0.0" },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service_name", "pipeline_template", "criticality"],
        "properties": {
          "service_name": { "type": "string", "minLength": 1 },
          "pipeline_template": { "type": "string", "minLength": 1 },
          "criticality": { "type": "string", "enum": ["tier1", "tier2", "tier3"] }
        }
      }
    },
    "slos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slo_name", "service_name", "sli_type", "target", "window_days", "error_budget_minutes", "measurement_source"],
        "properties": {
          "slo_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,100}$" },
          "service_name": { "type": "string" },
          "sli_type": { "type": "string", "enum": ["availability", "latency", "correctness", "throughput", "saturation"] },
          "target": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
          "window_days": { "type": "integer", "enum": [7, 28, 30] },
          "error_budget_minutes": { "type": "number", "minimum": 0 },
          "measurement_source": { "type": "string", "minLength": 1 },
          "threshold": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    },
    "error_budget_policy": { "type": "string", "enum": ["pause_deploys", "alert_only", "burn_down"] },
    "burn_rate_rules": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["window", "burn_rate_threshold", "severity", "budget_consumed_pct"],
        "properties": {
          "window": { "type": "string", "enum": ["1h", "6h", "1d", "3d"] },
          "burn_rate_threshold": { "type": "number", "exclusiveMinimum": 0 },
          "severity": { "type": "string", "enum": ["page", "ticket"] },
          "budget_consumed_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sample_interval_seconds": { "type": "integer", "minimum": 1 },
        "retention_class": { "type": "string", "enum": ["operational-30d", "aggregate-90d"] }
      }
    }
  }
}
