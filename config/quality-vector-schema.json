{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Albadry-Esmat/AI-Workflow/schemas/quality-vector.schema.json",
  "title": "AI-Workflow Quality Vector",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "dimensions", "weighted_score", "blockers", "verdict"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "behavior", "security", "traceability", "budget", "retry", "policy", "context", "release_compatibility"],
      "properties": {
        "structure": { "$ref": "#/$defs/dimension" },
        "behavior": { "$ref": "#/$defs/dimension" },
        "security": { "$ref": "#/$defs/dimension" },
        "traceability": { "$ref": "#/$defs/dimension" },
        "budget": { "$ref": "#/$defs/dimension" },
        "retry": { "$ref": "#/$defs/dimension" },
        "policy": { "$ref": "#/$defs/dimension" },
        "context": { "$ref": "#/$defs/dimension" },
        "release_compatibility": { "$ref": "#/$defs/dimension" }
      }
    },
    "weighted_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker" },
      "uniqueItems": true
    },
    "verdict": { "type": "string", "enum": ["pass", "block"] },
    "feedback": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "blockers": { "minItems": 1 } } },
      "then": { "properties": { "verdict": { "const": "block" } } }
    },
    {
      "if": { "properties": { "verdict": { "const": "pass" } } },
      "then": { "properties": { "blockers": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "weight", "status"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "blocking", "reason", "evidence_refs"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "severity": { "type": "string", "enum": ["critical", "high"] },
        "blocking": { "type": "boolean", "const": true },
        "reason": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
