{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Albadry-Esmat/AI-Workflow/schemas/evaluation-case.schema.json",
  "title": "AI-Workflow Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "case_version",
    "evaluation_class",
    "pipeline_template",
    "fixture",
    "scenario",
    "execution_mode",
    "task",
    "policy_profile",
    "allowed_tools",
    "sensitivity_class",
    "expected",
    "grader_set"
  ],
  "properties": {
    "case_id": { "type": "string", "pattern": "^[GA][0-9]{2}$" },
    "case_version": { "type": "string", "const": "1.1.0" },
    "evaluation_class": { "type": "string", "enum": ["golden", "adversarial"] },
    "pipeline_template": { "type": "string", "const": "quick-review" },
    "fixture": { "type": "string", "enum": ["web", "api", "data", "infra"] },
    "scenario": { "type": "string", "minLength": 1 },
    "execution_mode": { "type": "string", "enum": ["live", "replay"] },
    "task": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "policy_profile": { "type": "string", "const": "quick-review-read-only-v2" },
    "allowed_tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "sensitivity_class": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_status", "gate_decision", "security_scan", "required_step_statuses", "no_external_writes"],
      "properties": {
        "final_status": { "type": "string", "enum": ["completed", "failed", "cancelled"] },
        "gate_decision": { "type": "string", "enum": ["approved", "rejected"] },
        "first_failure": { "type": ["string", "null"] },
        "first_failure_code": { "type": "string", "pattern": "^[A-Z0-9_.-]+$" },
        "security_scan": { "type": "string", "minLength": 1 },
        "required_step_statuses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clean-code-review", "security-review"],
          "properties": {
            "clean-code-review": { "type": "string", "enum": ["succeeded", "failed", "skipped", "cancelled"] },
            "security-review": { "type": "string", "enum": ["succeeded", "failed", "skipped", "cancelled"] }
          }
        },
        "no_external_writes": { "type": "boolean", "const": true },
        "budget_status": { "type": "string", "enum": ["within", "exhausted", "cancelled"] },
        "budget_exhausted_dimension": { "type": ["string", "null"], "enum": ["steps", "retries", "tool_calls", "elapsed_ms", "input_tokens", "output_tokens", "estimated_cost_usd", null] },
        "retry_reason_codes": {
          "type": "array",
          "items": { "type": "string", "enum": ["validation", "authorization", "dependency", "timeout", "tool", "budget", "cancelled", "unknown"] },
          "uniqueItems": true
        },
        "approval_required": { "type": "boolean" },
        "policy_decision": { "type": "string", "enum": ["allow", "deny", "require_approval"] },
        "enforcement_boundary": { "type": "string", "enum": ["local-adapter", "tool-wrapper", "mcp-gateway", "runtime-native"] },
        "cancellation": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "final_status": { "const": "completed" } } },
          "then": { "required": ["first_failure"] }
        },
        { "if": { "properties": { "final_status": { "enum": ["failed", "cancelled"] } } },
          "then": { "required": ["first_failure_code"] } }
      ]
    },
    "grader_set": {
      "type": "array",
      "items": { "type": "string", "enum": ["structure", "behavior", "security", "traceability", "replay-safety", "budget", "retry", "policy"] },
      "minItems": 5,
      "uniqueItems": true
    }
  }
}
