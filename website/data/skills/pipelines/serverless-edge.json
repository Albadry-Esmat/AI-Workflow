{
  "$schema": "../schema/pipeline-schema.json",
  "name": "serverless-edge",
  "version": "1.0.0",
  "description": "Serverless and edge delivery pipeline with cold-start constraints, 1MB edge bundle enforcement, environment declaration checks, and provider-specific deployment.",
  "domain": "serverless_edge",
  "mode": "hybrid",
  "on_failure": "halt",
  "phases": [
    {
      "id": "phase-1-requirements",
      "label": "Requirements",
      "skills": [
        {
          "name": "requirement-analyzer",
          "version": "1.3.0",
          "max_retries": 2
        }
      ]
    },
    {
      "id": "phase-2a-architecture",
      "label": "Serverless Edge Architecture",
      "skills": [
        {
          "name": "architecture-design",
          "version": "1.4.0",
          "max_retries": 2,
          "config": {
            "edge_runtime": true,
            "providers": ["cloudflare_workers", "vercel_edge", "aws_lambda_edge", "deno_deploy"],
            "constraints": ["no_filesystem", "no_long_lived_connections", "no_native_node_modules"]
          }
        }
      ]
    },
    {
      "id": "phase-2b-cold-start",
      "label": "Cold-Start Constraints",
      "skills": [
        {
          "name": "architecture-design",
          "version": "1.4.0",
          "max_retries": 2,
          "config": {
            "cold_start_spec": {
              "max_startup_ms": 10,
              "provider_limits_ms": {
                "cloudflare_workers": 10,
                "vercel_edge": 10,
                "aws_lambda_edge": 100,
                "deno_deploy": 10
              },
              "tree_shaking_required": true,
              "static_es_modules_required": true,
              "forbid_runtime_require": true,
              "lazy_load_heavy_modules": true
            }
          }
        }
      ]
    },
    {
      "id": "phase-2c-edge-runtime",
      "label": "Edge Runtime Specialist",
      "skills": [
        {
          "name": "serverless-architect",
          "version": "1.0.0",
          "max_retries": 2,
          "config": {
            "runtime_constraints": {
              "no_fs": true,
              "no_long_lived_connections": true,
              "no_native_node_modules": true,
              "cpu_time_limit_ms": 50
            }
          }
        }
      ]
    },
    {
      "id": "phase-3-feature-plan",
      "label": "Feature Planning",
      "skills": [
        {
          "name": "feature-planning",
          "version": "2.2.1",
          "max_retries": 2,
          "config": {
            "edge_compatibility_tasks": true,
            "provider_deployment_tasks": true
          }
        }
      ]
    },
    {
      "id": "phase-4-impact",
      "label": "Dependency and Impact Analysis",
      "parallel": true,
      "skills": [
        {
          "name": "dependency-analyzer",
          "version": "1.1.0",
          "max_retries": 1
        },
        {
          "name": "change-impact-analyzer",
          "version": "1.2.0",
          "max_retries": 1,
          "config": {
            "change_type": "architecture",
            "edge_runtime_impact": true
          }
        }
      ]
    },
    {
      "id": "phase-5-code-gen",
      "label": "Edge-Compatible Code and Test Scaffolding",
      "skills": [
        {
          "name": "code-generator",
          "version": "1.1.0",
          "max_retries": 2,
          "config": {
            "edge_compatible_patterns": true,
            "static_imports_only": true
          }
        },
        {
          "name": "test-generator",
          "version": "2.1.0",
          "max_retries": 2,
          "config": {
            "modes": ["unit", "integration"],
            "edge_test_runtimes": ["miniflare", "wrangler"]
          }
        }
      ]
    },
    {
      "id": "phase-6-test-strategy",
      "label": "Serverless Test Strategy",
      "skills": [
        {
          "name": "testing-strategy",
          "version": "2.0.0",
          "max_retries": 2,
          "config": {
            "edge_runtime_tests": true,
            "cold_start_benchmarking": true,
            "provider_matrix": true
          }
        }
      ]
    },
    {
      "id": "phase-7a-review",
      "label": "Code and Security Review",
      "parallel": true,
      "skills": [
        {
          "name": "clean-code-review",
          "version": "1.1.0",
          "max_retries": 1
        },
        {
          "name": "security-review",
          "version": "1.1.0",
          "max_retries": 1
        }
      ]
    },
    {
      "id": "phase-7b-bundle-size-guard",
      "label": "Edge Guard Layer",
      "parallel": true,
      "skills": [
        {
          "name": "bundle-size-guard",
          "version": "1.0.0",
          "max_retries": 1,
          "type": "validation_check",
          "config": {
            "scope": "edge",
            "max_bundle_size_mb": 1,
            "max_bundle_size_bytes": 1048576,
            "hard_limit": true,
            "per_function": true,
            "uncompressed": true
          }
        },
        {
          "name": "security-guard",
          "version": "1.0.0",
          "max_retries": 1,
          "type": "validation_check"
        },
        {
          "name": "performance-guard",
          "version": "1.1.0",
          "max_retries": 1,
          "type": "validation_check",
          "config": {
            "cold_start_max_ms": 10,
            "edge_cpu_limits": true
          }
        }
      ]
    },
    {
      "id": "phase-8a-deployment",
      "label": "Provider Deployment",
      "skills": [
        {
          "name": "deployment-strategy",
          "version": "1.1.0",
          "max_retries": 2,
          "config": {
            "provider": "cloudflare_workers|vercel_edge|aws_lambda_edge|deno_deploy",
            "provider_options": ["cloudflare_workers", "vercel_edge", "aws_lambda_edge", "deno_deploy"],
            "edge_deployment": true,
            "provider_limits_required": true
          }
        }
      ]
    },
    {
      "id": "phase-8b-env-config",
      "label": "Environment Configuration",
      "skills": [
        {
          "name": "environment-config-manager",
          "version": "1.0.0",
          "max_retries": 1,
          "type": "validation_check",
          "config": {
            "edge_runtime": true,
            "require_all_secrets_declared": true,
            "restricted_env_access": true,
            "provider_overlays": true,
            "fail_closed_on_undeclared_required_vars": true
          }
        }
      ]
    },
    {
      "id": "phase-8c-connection-safety",
      "label": "Connection Pooling Safety",
      "skills": [
        {
          "name": "serverless-architect",
          "version": "1.0.0",
          "max_retries": 1,
          "config": {
            "connection_strategy": "http_serverless_driver",
            "forbid_long_lived_database_connections": true,
            "approved_patterns": ["prisma_data_proxy", "planetscale_serverless_driver"]
          }
        }
      ]
    },
    {
      "id": "phase-9-docs",
      "label": "Documentation",
      "skills": [
        {
          "name": "documentation-generator",
          "version": "1.0.0",
          "max_retries": 1,
          "config": {
            "include_provider_limits": true,
            "include_cold_start_spec": true,
            "include_environment_contract": true
          }
        }
      ]
    },
    {
      "id": "phase-10-async",
      "label": "Async Synchronization",
      "async": true,
      "skills": [
        {
          "name": "doc-maintainer",
          "version": "1.1.0",
          "max_retries": 1,
          "async": true
        },
        {
          "name": "work-item-exporter",
          "version": "2.0.0",
          "max_retries": 1,
          "async": true
        }
      ]
    }
  ],
  "parallel_groups": [
    ["dependency-analyzer", "change-impact-analyzer"],
    ["clean-code-review", "security-review"],
    ["bundle-size-guard", "security-guard", "performance-guard"]
  ],
  "gates": [
    {
      "gate_id": "EDGE-ARCHITECTURE-APPROVAL",
      "after_phase": "phase-2c-edge-runtime",
      "type": "human_approval",
      "bypass_on_timeout": false,
      "timeout": 3600,
      "label": "Approve edge runtime, provider, and cold-start constraints"
    },
    {
      "gate_id": "EDGE-BUNDLE-GUARDS-PASS",
      "after_phase": "phase-7b-bundle-size-guard",
      "type": "condition",
      "condition": "guards && guards.every(g => g.verdict === 'pass')",
      "label": "Fail closed unless every edge guard passes",
      "note": "A missing bundle measurement, security result, performance result, or non-pass verdict blocks progression."
    },
    {
      "gate_id": "EDGE-BUNDLE-APPROVAL",
      "after_phase": "phase-7b-bundle-size-guard",
      "type": "human_approval",
      "bypass_on_timeout": false,
      "timeout": 3600,
      "label": "Approve bundle size and edge compatibility evidence"
    },
    {
      "gate_id": "EDGE-ENV-CONFIG-PASS",
      "after_phase": "phase-8b-env-config",
      "type": "condition",
      "condition": "environment_config && environment_config.verdict === 'clean'",
      "label": "Block deployment unless environment configuration is clean",
      "note": "Undeclared required variables and missing configuration evidence fail closed."
    },
    {
      "gate_id": "EDGE-DEPLOYMENT-APPROVAL",
      "after_phase": "phase-8c-connection-safety",
      "type": "human_approval",
      "bypass_on_timeout": false,
      "timeout": 0,
      "label": "Approve provider deployment"
    }
  ],
  "recovery": {
    "on_critical_failure": "rollback-manager",
    "max_repair_iterations": 2,
    "rollback_scope": "pipeline_stage"
  },
  "async_skills": ["doc-maintainer", "work-item-exporter"],
  "token_policy": {
    "auto_compress": true,
    "trigger_at_percent": 85,
    "default_tier": "standard",
    "budget_tiers": [
      {"name": "standard", "ceiling": 16000, "cascade_mode": "single_pass"},
      {"name": "large", "ceiling": 32000, "cascade_mode": "cascade"},
      {"name": "xl", "ceiling": 48000, "cascade_mode": "cascade"}
    ]
  }
}
